{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "odata-server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:service", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web-static-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8901", "--directory", "../web.opteryx/static"],
      "port": 8901
    }
  ]
}
